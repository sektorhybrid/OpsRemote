# OpsRemote: only sources, packaging and documentation are published.
# Everything built, packaged, or personal stays on your computer.

# ---- Build output and packages ----
/build/
/dist/
*.tar.gz
*.tar.zst
*.zip
*.7z

# ---- Personal data (never publish) ----
# Old personal files kept for reference.
/archived/
# Private plans, not published.
/private/
# Design notes and reviews: kept locally, not published.
/design/
# What OpsRemote writes next to itself: sessions, preferences, the
# encrypted vault, trusted host keys and certificates, backups, and the
# unpacked program.
settings/
backups/
runtime/
.runtime/
*.vault
known_hosts
*.log

# ---- Editors and tools ----
__pycache__/
*.pyc
.vscode/
.idea/
.claude/
.cache/
*.user
*.swp
*~
.DS_Store
compile_commands.json
CMakeLists.txt.user*
CMakeCache.txt
CMakeFiles/

